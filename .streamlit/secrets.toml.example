# عند النشر على Streamlit Community Cloud:
# 1. اذهب لإعدادات التطبيق (Settings) -> Secrets
# 2. الصق المحتوى التالي وعدّل DATABASE_URL بالقيمة الحقيقية من مزوّد قاعدة البيانات (مثل Neon)
# لا تحتاج ترفع هذا الملف نفسه لأي مكان عام (لا GitHub ولا غيره)، فقط الصق محتواه داخل واجهة Streamlit Cloud

DATABASE_URL = "postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require"
